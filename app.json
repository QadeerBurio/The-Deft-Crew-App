{
  "expo": {
    "name": "tdc",
    "slug": "Testting",
    "version": "1.1.13",
    "orientation": "default",
    "icon": "./assets/tdc.png",
    "scheme": "tdcapp",
    "backgroundColor": "#000000",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/tdci.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aqkhan110.tdc",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "TDC uses the microphone to record and send voice messages in chats.",
        "NSLocationWhenInUseUsageDescription": "tdc uses your location to show deals near you and to share your location in chats.",
        "NSPhotoLibraryUsageDescription": "TDC uses your photo library so you can select photos to upload to your profile and share with other users.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.aqkhan110.tdc",
      "allowBackup": false,
      "versionCode": 82,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/tdci.png",
        "backgroundColor": "#000000"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "geo"
          }
        },
        {
          "action": "VIEW",
          "data": {
            "scheme": "https",
            "host": "www.google.com",
            "pathPrefix": "/maps"
          }
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "tdcapp"
            },
            {
              "scheme": "https",
              "host": "the-deft-crew-production.up.railway.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#f9c349",
          "defaultChannel": "tdc2_tdc_push_default",
          "sounds": [
            "./assets/sounds/push/tdc_push_default.wav",
            "./assets/sounds/push/tdc_push_deal.wav",
            "./assets/sounds/push/tdc_push_message.wav",
            "./assets/sounds/push/tdc_push_internship.wav",
            "./assets/sounds/push/tdc_push_reminder.wav",
            "./assets/sounds/push/tdc_push_points.wav",
            "./assets/sounds/push/tdc_push_streak.wav",
            "./assets/sounds/push/tdc_push_confession.wav",
            "./assets/sounds/push/tdc_push_event.wav",
            "./assets/sounds/push/tdc_push_level_up.wav",
            "./assets/sounds/moods/tdc_mood_sorted.wav",
            "./assets/sounds/moods/tdc_mood_excited.wav",
            "./assets/sounds/moods/tdc_mood_panic.wav",
            "./assets/sounds/moods/tdc_mood_broke.wav",
            "./assets/sounds/moods/tdc_mood_sleepy.wav",
            "./assets/sounds/moods/tdc_mood_shook.wav",
            "./assets/sounds/moods/tdc_mood_sus.wav",
            "./assets/sounds/moods/tdc_mood_cheeky.wav",
            "./assets/sounds/moods/tdc_mood_rs.wav",
            "./assets/sounds/ui/tdc_like.wav",
            "./assets/sounds/ui/tdc_nope.wav"
          ],
          "androidMode": "default",
          "androidCollapsedTitle": "New notification from TDC"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "hermesEnabled": true,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0",
            "enableProguardInReleaseBuilds": false
          },
          "ios": {
            "hermesEnabled": true
          }
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "TDC uses the microphone to record and send voice messages in chats."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "tdc uses your location to show deals near you and to share your location in chats."
        }
      ],
      "expo-navigation-bar",
      "expo-web-browser",
      "expo-font",
      "expo-task-manager"
    ],
    "extra": {
      "eas": {
        "projectId": "112506b0-7553-4a1b-afeb-6a37019cc15f"
      }
    },
    "owner": "aqkhan622"
  }
}
